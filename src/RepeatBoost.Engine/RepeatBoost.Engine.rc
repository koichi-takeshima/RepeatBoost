#pragma code_page(65001)

#include "resource.h"
#include <winres.h>

#define RB_STRINGIZE_INNER(value) #value
#define RB_STRINGIZE(value) RB_STRINGIZE_INNER(value)

IDI_REPEATBOOST ICON "../../assets/RepeatBoost.ico"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
VS_VERSION_INFO VERSIONINFO
 FILEVERSION REPEATBOOST_VERSION_MAJOR,REPEATBOOST_VERSION_MINOR,REPEATBOOST_VERSION_PATCH,0
 PRODUCTVERSION REPEATBOOST_VERSION_MAJOR,REPEATBOOST_VERSION_MINOR,REPEATBOOST_VERSION_PATCH,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "RepeatBoost Engine"
            VALUE "FileVersion", RB_STRINGIZE(REPEATBOOST_WINDOWS_VERSION)
            VALUE "InternalName", "RepeatBoost.Engine"
            VALUE "OriginalFilename", "RepeatBoost.Engine.exe"
            VALUE "ProductName", "RepeatBoost"
            VALUE "ProductVersion", RB_STRINGIZE(REPEATBOOST_PRODUCT_VERSION)
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
IDR_TRAY_MENU MENU
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "Enable",   IDM_TRAY_ENABLE
        MENUITEM "Settings", IDM_TRAY_SETTINGS
        MENUITEM SEPARATOR
        MENUITEM "Exit",     IDM_TRAY_EXIT
    END
END

LANGUAGE LANG_JAPANESE, SUBLANG_DEFAULT
IDR_TRAY_MENU MENU
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "有効", IDM_TRAY_ENABLE
        MENUITEM "設定", IDM_TRAY_SETTINGS
        MENUITEM SEPARATOR
        MENUITEM "終了", IDM_TRAY_EXIT
    END
END
